        for (int x : loop) if (x != 10 && x != 21 && x != 11) l2.push_back(x);
        size_t at12 = std::find(l2.begin(), l2.end(), 12) - l2.begin();
        loop.assign(l2.begin() + at12, l2.end()); loop.insert(loop.end(), l2.begin(), l2.begin() + at12);
        for (auto& r : path_recs) loop.push_back(r.id);
