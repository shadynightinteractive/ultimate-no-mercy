        bool any = false; int z_end = 0;
        for (auto& o : fl) if (std::abs(o.x0 + o.x1) <= 400) { z_end = any ? std::min(z_end, o.z0) : o.z0; any = true; }
        if (!any) z_end = (*rs)["bbox"][3].get<int>() + 200;
        Rec r55 = game_rec(a, 55);
        for (int q = 0; q < 4; q++) if (r55.c[3 * q + 2] == 800) r55.c[3 * q + 2] = z_end;
        for (auto& r : S.recs) if (r.id == 55) r = r55;
        Rec rt = game_rec(a, 55);
        for (auto& o : fl) {
            Rec r = rt; r.id = i_;
            r.c = { o.x0, o.y1, o.z1, o.x1, o.y1, o.z1, o.x1, o.y0, o.z0, o.x0, o.y0, o.z0 };
            S.recs.push_back(r); floors_rs.push_back(i_); i_++;
        }
        arrive = door_at ? std::array<int, 2>{ (*door_at)[0], (*door_at)[1] - 60 } : std::array<int, 2>{ 0, (*rs)["bbox"][3].get<int>() - 80 };
    }
    auto ring = [&](const std::vector<int>& r) { for (size_t i = 0; i < r.size(); i++) S.nxt[r[i]] = r[(i + 1) % r.size()]; };
    ring(loop);
