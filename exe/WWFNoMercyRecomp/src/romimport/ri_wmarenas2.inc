    S.lists.push_back({ "top", { "top4" } }); S.lists.push_back({ "t28", { "t28" } }); S.lists.push_back({ "t30", { "t30" } });
    S.lists.push_back({ "aisle", { "aisle" } }); S.lists.push_back({ "plane", { "plane" } }); S.lists.push_back({ "toplist", { "top", "floor", "top4" } });
    S.fz.push_back({ addr(G_RING_SPAN), { addr(G_RING_LIST), addr(G_RING_LIST), addr(G_RING_LIST), addr(G_RING_LIST) } });
    if (table) S.fz.push_back({ "top", { "toplist", "toplist", "toplist", "toplist" } });
