                { "aisle", { 22, 23 } }, { "plane", { 0, 0 } }, { "top4", { 78, 81 } }, { "top", { 82, 82 } }, { "t28", { 83, 84 } }, { "t30", { 85, 86 } } };
    if (!table) { S.spans.push_back({ "apr0", { 38, 37 } }); S.spans.push_back({ "apr1", { 31, 37 } }); S.spans.push_back({ "apr2", { 32, 38 } }); S.spans.push_back({ "apr3", { 37, 31 } }); }
    std::vector<std::string> prop_spans;
    for (size_t j = 0; j < props.size(); j++) { S.spans.push_back({ "prop" + std::to_string(j), { props[j].front(), props[j].back() } }); prop_spans.push_back("prop" + std::to_string(j)); }
    for (int q = 0; q < 4; q++) {
        std::string apron = table ? addr(G_APRON_Q[q]) : "apr" + std::to_string(q), bar = "bar" + std::to_string(q);
        std::vector<std::string> zq = { bar, apron }, f1 = { "floor", addr(G_SKIRT), bar }, f2 = { "floor", apron, bar };
        if (q == 0) for (auto& s : prop_spans) { zq.push_back(s); f1.push_back(s); f2.push_back(s); }
