    else ring({ 24, 25, 26, 27, 28 });
    ring({ 22, 23 });
    { std::vector<int> f = { 55 }; f.insert(f.end(), floors_rs.begin(), floors_rs.end()); f.push_back(56); ring(f); }
    ring({ 0 }); ring({ 78, 79, 80, 81 }); ring({ 82 }); ring({ 83, 84 }); ring({ 85, 86 });
