// ==== gen/arenas.py build (and what wmport.py build_all calls after it) =======================================================
void wm_arenas(WmCtx& C) {
    A a(C);
    // (arenasplit 2026-11-24) each game's scenes only with it; with one of the two, its arenas alone (A::here)
    if (C.rev) {
        const Bytes& md = C.image("rev_ent0");
        a.scenes = rev_scenes(md);
    }
    if (C.wm) {
        a.wm_scenes = wm3d_scenes(C.image("wm_close1"));
        a.wm_venues = wm_venues(C.image("wm_fly1"));
    }
    { Bytes lb = read_file(C.D.dir / "frozen" / "arena_labels.json"); a.labels = ojson::parse(std::string(lb.begin(), lb.end())); }
    Pool& F = C.F;
    std::vector<ARow> rows;
    for (int k = 0; k < N_ARENAS; k++) {
        const ArenaDef& ad = ARENAS[k];
        ARow r; r.name = ad.name; r.rev = ad.rev; r.wm = ad.wm;
        if (!a.here(k)) { r.here = false; rows.push_back(r); continue; }   // (arenasplit: its game isn't there -- the row zeros)
        if (ad.wm >= 0) {                                       // arenas_wm.arena_row
            const WmVenue& V = a.venue(ad.wm);
            for (auto& p : V.stage) { r.meshes.push_back(F.one(p.mesh)); r.pals.push_back(F.pair(p.pic.tex, p.pic.pal).second); }
            for (auto& p : V.apron) r.apron_pal.push_back(F.pair(p.pic.tex, p.pic.pal).second);
            auto wt = white_pic(); uint32_t white = F.pair(wt.first, wt.second).second;
            r.apron_pal.resize(8, white);
            r.truss_pal = { 0x80B, 0x80B, 0x80D, white, white };
            r.lab = F.one(a.label(ad.name));
            std::vector<RrPiece> ps;
            for (auto& q : V.rr) ps.push_back({ q.mesh, q.tex, q.pal, q.turns });
            std::vector<Bytes> back;
            auto tiles = photo_tiles(a, ps, nullptr, V.logo_tex, V.logo_pal, back);
            r.prev = first_of(F, tiles); r.back = first_of(F, back);
            rows.push_back(r);
            continue;
        }
        int v = ad.rev;
        RevTable t = a.table(v);
        for (auto& [mb, p] : s3_ring_parts(a, v)) { uint32_t pl = a.pic_pair(p).second; r.meshes.push_back(F.one(mb)); r.pals.push_back(pl); }
        uint32_t pal = F.pair(a.rf(t.aisle[0] + 1), a.rf(t.aisle[0])).second;
        if (r.meshes.size() < (size_t)SET_MAX) { r.meshes.push_back(F.one(a.rf(AISLE_FLOOR))); r.pals.push_back(pal); }
        int ap = t.ring[2];
        uint32_t right = F.pair(apron_half(a.rf(ap + 1), true), a.rf(ap)).second;
        uint32_t left = F.pair(apron_half(a.rf(ap + 1), false), a.rf(ap)).second;
        uint32_t banner = F.pair(a.rf(banner_of(v) + 1), a.rf(banner_of(v))).second;
        r.lab = F.one(a.label(label_of(v)));
        std::vector<std::pair<Bytes, Bytes>> sky;
        if (v == 3) {                     // (Bash at the Beach's sky: its 3D stage's three sky walls, left to right)
            const ojson& ms = s3_models(a, v);
            for (const char* nm : { "t07_p06.png", "t05_p04.png", "t03_p02.png" })
                for (auto& m : ms) if (m["texture"] == nm) { Pic p = s3_picture(a, v, m); sky.push_back({ p.tex, p.pal }); break; }
        }
        std::vector<Bytes> back;
        auto tiles = photo_tiles(a, rev_rr_pieces(a, v), v == 3 ? &sky : nullptr, a.rf(logo_of(v) + 1), a.rf(logo_of(v)), back);
        r.prev = first_of(F, tiles); r.back = first_of(F, back);
        r.apron_pal = { right, left, right, left, right, left, right, left };
        r.truss_pal = { 0x80B, 0x80B, 0x80D, banner, banner };
        rows.push_back(r);
    }
    // arena_files.h
    std::string L = "// generated by gen/arenas.py: WCW/nWo Revenge's arenas (arena.c): each one's stage set, in the base arena's\n"
                    "// place (its meshes / palettes, the texture the palette's file + 1: gen/wmport.py's pack)\n";
    L += strf("#define XARENA_N %zu\n#define XARENA_BASE %d   // (the base arena: the game's venue)\n#define XARENA_SET_MAX %d   // (src/arena.c ARENA_SET_MAX: the stage set's parts)\n", rows.size(), BASE, SET_MAX);
    std::string nm;
    for (size_t i = 0; i < rows.size(); i++) nm += (i ? ", " : "") + ("\"" + rows[i].name + "\"");
    L += "static const char* const xarena_names[XARENA_N] = { " + nm + " };\n";
    std::vector<size_t> page(rows.size());
    for (size_t i = 0; i < rows.size(); i++) page[i] = i;
    std::stable_sort(page.begin(), page.end(), [&](size_t x, size_t y) {
        auto key = [&](size_t k) { return rows[k].wm >= 0 ? std::make_pair(0, rows[k].wm) : std::make_pair(1, rows[k].rev); };
        return key(x) < key(y); });
    std::string po;
    for (size_t i = 0; i < page.size(); i++) po += (i ? ", " : "") + std::to_string(page[i]);
    L += "static const u8 xarena_page_order[XARENA_N] = { " + po + " };   // (the rows above, as the ARENA page lists them)\n";
    L += "static const u16 xarena_truss_pal[XARENA_N][5] = {   // (0x8005078C[v]: the light truss, the 2 banners)\n";
    for (auto& r : rows) L += r.here ? "    { " + hexlist(r.truss_pal) + " },\n" : std::string("    { 0, 0, 0, 0, 0 },\n");   // (arenasplit)
    L += "};\n// the ARENA page: a row's label (128 x 32 CI4), the photo's six tiles (first + k), the VS backdrop's forty (first + t)\n";
    std::vector<uint32_t> lab, prev, back;
    for (auto& r : rows) { lab.push_back(r.lab); prev.push_back(r.prev); back.push_back(r.back); }
    L += "static const u16 xarena_label_file[XARENA_N] = { " + hexlist(lab) + " };\n";
    L += "static const u16 xarena_preview_file[XARENA_N] = { " + hexlist(prev) + " };\n";
    L += "static const u16 xarena_backdrop_file[XARENA_N] = { " + hexlist(back) + " };\n";
    C.header("arena_files.h", L);
    C.header("arena_table_files.h", table_header(a, rows.size()));
    C.log.push_back(strf("part %zu arcade arenas' rows (Revenge / WM2000 stage sets, aprons, labels, photos, backdrops)", F.data.size()));
    ring_build(a);
    C.log.push_back(strf("part %zu ringside lists (Revenge's shared, WM2000's per venue)", F.data.size()));
    entrance_build(a, rows);
    C.log.push_back(strf("part %zu entrance close scenes", F.data.size()));
    // (arenasplit 2026-11-24) The game's ten's stage sets are the pack's last files, at the build's places (a base hole of the
    // pack's table): a pack made from one of the two source games is shorter than the build's, so the game reads them from
    // content\wmport_base.bin under it (arcade_packs.cpp) -- they aren't made here then (nor their headers, which nothing of
    // the extras reads).
    if (!a.full()) { C.log.push_back("the game's ten's stage sets: content\\wmport_base.bin's (one of the two source games)"); return; }
    raw_build(a);
    C.log.push_back(strf("part %zu No Mercy RAW IS WAR stage set", F.data.size()));
    stages_build(a);
    C.log.push_back(strf("part %zu No Mercy venues 1-9 stage sets", F.data.size()));
}

// ==== gen/arenas_walls.py: each arena's own walls (arena_walls_files.h) and its ring-and-stage map (arena_ringstage_files.h) ====
namespace {
struct Rec { int id; std::array<int, 12> c; int fl, kind; };
uint32_t rec_address(int id) {
    static const std::map<int, uint32_t> REC = {
        { 10, 0x801470F8 }, { 11, 0x80147128 }, { 12, 0x80147158 }, { 13, 0x80147188 }, { 14, 0x801471B8 }, { 15, 0x801471E8 }, { 16, 0x80147218 },
        { 17, 0x80147248 }, { 18, 0x80147278 }, { 19, 0x801472A8 }, { 20, 0x801472D8 }, { 21, 0x80147308 }, { 22, 0x80147390 }, { 23, 0x801473C0 },
        { 24, 0x80147410 }, { 25, 0x80147440 }, { 26, 0x80147470 }, { 27, 0x801474A0 }, { 28, 0x801474D0 }, { 55, 0x80147520 }, { 56, 0x80147550 },
        { 31, 0x80147600 }, { 29, 0x801475A0 }, { 30, 0x801475D0 }, { 34, 0x80147690 }, { 32, 0x80147630 }, { 33, 0x80147660 }, { 37, 0x80147720 },
        { 35, 0x801476C0 }, { 36, 0x801476F0 }, { 40, 0x801477B0 }, { 38, 0x80147750 }, { 39, 0x80147780 }, { 0, 0x80147B38 },
        { 78, 0x80147C50 }, { 79, 0x80147C80 }, { 80, 0x80147CB0 }, { 81, 0x80147CE0 }, { 82, 0x80147E38 }, { 83, 0x80147D30 }, { 84, 0x80147D60 },
        { 85, 0x80147D90 }, { 86, 0x80147DC0 } };
    auto it = REC.find(id);
    if (it != REC.end()) return it->second;
    if (id >= 297 && id < 315) return 0x801493D0 + 0x30 * (id - 297);
    if (id >= 315 && id <= 317) return 0x801497D0 + 0x30 * (id - 315);
    fail("no game record %d", id);
}
Rec game_rec(A& a, int i) {
    Bytes d = ovl_e(a, rec_address(i), 0x30);
    Rec r; r.id = i;
    for (int k = 0; k < 12; k++) r.c[k] = sx16(be16(d, 2 * k));
    if ((int)be16(d, 0x24) != i) fail("game record %d", i);
    r.fl = be16(d, 0x26); r.kind = be16(d, 0x28);
    return r;
}
std::array<double, 3> unit_normal(const std::array<int, 12>& c) {
    int64_t A0[3], B0[3];
    for (int k = 0; k < 3; k++) { A0[k] = c[3 + k] - c[k]; B0[k] = c[6 + k] - c[k]; }
    int64_t n[3] = { A0[1] * B0[2] - A0[2] * B0[1], A0[2] * B0[0] - A0[0] * B0[2], A0[0] * B0[1] - A0[1] * B0[0] };
    double l = std::sqrt((double)(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]));   // (sum of ints: exact)
    if (!l) return { 0.0, 0.0, 0.0 };
    return { n[0] / l, n[1] / l, n[2] / l };
}
Rec table_moved(Rec r) {
    auto& c = r.c;
    const std::array<int, 12> orig = r.c;                 // (zs: the corners' z as they were, for the planes' test)
    bool t = true, high = false, top = true;
    for (int q = 0; q < 4; q++) {
        int x = c[3 * q], y = c[3 * q + 1], z = c[3 * q + 2];
        if (!(std::abs(x) == 113 && 0 <= y && y <= 1000 && (z == -530 || z == -690))) t = false;
        if (y == 1000) high = true;
        if (y != 90) top = false;
    }
    if (t)
        for (int q = 0; q < 4; q++) {
            if (c[3 * q + 2] == -530) c[3 * q + 2] = -530 + 75;
            else if (c[3 * q + 2] == -690 && (high || top)) c[3 * q + 2] = -690 + 75 + 15;
        }
    bool all530 = true, all690 = true;
    for (int q = 0; q < 4; q++) { if (orig[3 * q + 2] != -530) all530 = false; if (orig[3 * q + 2] != -690) all690 = false; }
    if (r.id == 85 && all530) for (int q = 0; q < 4; q++) c[3 * q + 2] = -530 + 75;
    if (r.id == 86 && all690) for (int q = 0; q < 4; q++) c[3 * q + 2] = -690 + 75 + 15;
    return r;
}
Rec square(Rec r) {
    const int B = 530, Cc = 530 - 75, Ax = 140, Z = 800;
    static const std::map<int, std::array<int, 4>> ends = {
        { 10, { -Ax, Z, Ax, Z } }, { 11, { Ax, Z, Ax, B } }, { 12, { Ax, B, Cc, B } }, { 13, { Cc, B, B, Cc } }, { 14, { B, Cc, B, -Cc } },
        { 15, { B, -Cc, Cc, -B } }, { 16, { Cc, -B, -Cc, -B } }, { 17, { -Cc, -B, -B, -Cc } }, { 18, { -B, -Cc, -B, Cc } },
        { 19, { -B, Cc, -Cc, B } }, { 20, { -Cc, B, -Ax, B } }, { 21, { -Ax, B, -Ax, Z } } };
    auto it = ends.find(r.id);
    if (it != ends.end()) { auto e = it->second; r.c = { e[0], 100, e[1], e[2], 100, e[3], e[2], 0, e[3], e[0], 0, e[1] }; return r; }
    if (r.id == 56) { r.c = { -B, 0, B, B, 0, B, B, 0, -B, -B, 0, -B }; return r; }
    if (r.id == 0 || r.id == 86) for (int q = 0; q < 4; q++) if (r.c[3 * q + 2] == -690) r.c[3 * q + 2] = -B;
    return r;
}
Rec rs_wall(int i, std::array<int, 2> a, std::array<int, 2> b, int fl_class, int kind) {
    int dx = b[0] - a[0], dz = b[1] - a[1];
    if (!dx && !dz) fail("a wall of no length");
    int nx = dz, nz = -dx, d;
    if (std::abs(nx) >= std::abs(nz)) d = nx > 0 ? 0x0200 : 0x0100;
    else d = nz > 0 ? 0x0400 : 0x0800;
    Rec r{ i, { a[0], 1000, a[1], b[0], 1000, b[1], b[0], 0, b[1], a[0], 0, a[1] }, d | fl_class, kind };
    if (!(r.fl & 0x30F8)) fail("a wall a whipped man runs on the spot at");
    auto un = unit_normal(r.c);
    if (!(un[0] * nx + un[2] * nz > 0)) fail("a wall facing away from the walkable side");
    return r;
}
struct PW { std::array<int, 2> a, b; int crash, door; };
const int DOOR_ID[10] = { 306, 357, 95, 288, 218, 266, 402, 340, 231, 373 };
constexpr int DOOR_HALF = 90;
constexpr int DOOR_NEAR_Z = 60;   // (rs_crash_target: a wall this near the door's z is 'at the door'; Changed for new features (Ultimate No Mercy), was 30)
std::vector<PW> rs_path_door(const ojson& res, int n, std::optional<std::array<int, 2>>& door_at) {
    std::vector<PW> ws;
    for (auto& w : res["path"]) ws.push_back({ { w["a"][0].get<int>(), w["a"][1].get<int>() }, { w["b"][0].get<int>(), w["b"][1].get<int>() }, w["crash"].get<int>(), 0 });
    door_at.reset();
    if (n >= 10) return ws;
    // Changed for new features (Ultimate No Mercy): the stages agent, 2026-11-20 -- the door across the stage's middle
    // (x -DOOR_HALF..DOOR_HALF) in the wall furthest back there, where the game's ten have their doorway (arenas_walls.py
    // rs_path_door says why). Candidates: walls along x (a slant under 45 degrees too), way +x, not the first or last,
    // reaching DOOR_MIN or more into the middle; key (z at the reach's middle, the reach, -index): the greatest.
    constexpr long long DOOR_MIN = 80, DOOR_STEP = 40;
    auto fdiv = [](long long a, long long b) { return a >= 0 ? a / b : -((-a + b - 1) / b); };   // (Python's //, b > 0)
    auto along = [&](size_t k) { long long dx = (long long)ws[k].b[0] - ws[k].a[0], dz = (long long)ws[k].b[1] - ws[k].a[1]; return dx > 0 && std::llabs(dz) <= dx; };
    auto step = [&](size_t k) { long long dz = std::llabs((long long)ws[k].b[1] - ws[k].a[1]); return ws[k].a[0] == ws[k].b[0] && dz > 0 && dz <= DOOR_STEP; };
    auto z_at = [&](size_t k, long long x) { auto& w = ws[k]; return w.a[1] + fdiv(((long long)w.b[1] - w.a[1]) * (x - w.a[0]), (long long)w.b[0] - w.a[0]); };
    bool have = false; long long bz = 0, bw = 0, lo = 0, hi = 0; size_t i = 0;
    for (size_t k = 0; k < ws.size(); k++) {
        if (k == 0 || k == ws.size() - 1 || !along(k)) continue;
        long long klo = std::max<long long>(ws[k].a[0], -DOOR_HALF), khi = std::min<long long>(ws[k].b[0], DOOR_HALF);
        if (khi - klo < DOOR_MIN) continue;
        long long zm = z_at(k, fdiv(klo + khi, 2));
        if (!have || zm > bz || (zm == bz && (khi - klo > bw || (khi - klo == bw && k < i)))) { have = true; bz = zm; bw = khi - klo; lo = klo; hi = khi; i = k; }
    }
    if (!have) return ws;
    // (short of the very middle at a step of the map's stairs: on across it to the next wall along x)
    size_t j = i;
    while (lo > -DOOR_MIN / 2 && i >= 3 && step(i - 1) && along(i - 2)) { i -= 2; lo = std::max<long long>(ws[i].a[0], -DOOR_HALF); }
    while (hi < DOOR_MIN / 2 && j + 4 <= ws.size() && step(j + 1) && along(j + 2)) { j += 2; hi = std::min<long long>(ws[j].b[0], DOOR_HALF); }
    std::array<int, 2> d0 = { (int)lo, (int)z_at(i, lo) }, d1 = { (int)hi, (int)z_at(j, hi) };
    PW wi = ws[i], wj = ws[j];
    std::vector<PW> out(ws.begin(), ws.begin() + i);
    if (d0 != wi.a) out.push_back({ wi.a, d0, wi.crash, 0 });
    out.push_back({ d0, d1, 1, DOOR_ID[n] });
    if (d1 != wj.b) out.push_back({ d1, wj.b, wj.crash, 0 });
    out.insert(out.end(), ws.begin() + j + 1, ws.end());
    door_at = std::array<int, 2>{ (int)fdiv((long long)d0[0] + d1[0], 2), (int)fdiv((long long)d0[1] + d1[1], 2) };
    return out;
}
struct Strip { int x0, x1, z0, z1, y0, y1; };
bool cell_none(const ojson& c) { return c.is_null(); }
std::vector<Strip> rs_floors(const ojson& res) {
    const ojson& g = res["grid"]; const int G = 40;
    int gw = g["w"].get<int>(), gh = g["h"].get<int>(), x0 = g["x0"].get<int>(), z0 = g["z0"].get<int>();
    std::vector<Strip> strips;
    for (int k = 0; k < gh; k++) {
        const ojson& row = g["cells"][k];
        int i = 0;
        while (i < gw) {
            if (cell_none(row[i]) || row[i].get<int64_t>() < 8) { i++; continue; }
            int64_t h = row[i].get<int64_t>();
            int j = i;
            while (j + 1 < gw && !cell_none(row[j + 1]) && std::llabs(row[j + 1].get<int64_t>() - h) <= 4) j++;
            strips.push_back({ x0 + i * G, x0 + (j + 1) * G, z0 + k * G, z0 + (k + 1) * G, (int)h, (int)h });
            i = j + 1;
        }
    }
    std::vector<Strip> out;
    for (auto& t : strips) {
        bool merged = false;
        for (auto& o : out)
            if (o.x0 == t.x0 && o.x1 == t.x1 && o.z1 == t.z0) {
                double n_ = (o.z1 - o.z0) / (double)G;
                double slope = n_ != 0 ? (o.y1 - o.y0) / n_ : 0;
                double rhs = n_ != 0 ? o.y1 + slope : (double)t.y0;
                if (std::fabs((t.y0 + slope) - rhs) <= 6 || (o.y1 == o.y0 && o.y0 == t.y0)) { o.z1 = t.z1; o.y1 = t.y1; merged = true; break; }
            }
        if (!merged) out.push_back(t);
    }
    std::stable_sort(out.begin(), out.end(), [](const Strip& p, const Strip& q) {
        return -(int64_t)(p.x1 - p.x0) * (p.z1 - p.z0) < -(int64_t)(q.x1 - q.x0) * (q.z1 - q.z0); });
    if (out.size() > 24) out.resize(24);
    return out;
}
std::array<int, 3> rs_crash_target(const ojson& res, const std::optional<std::array<int, 2>>& door_at) {
    const ojson& g = res["grid"]; const int G = 40;
    int gw = g["w"].get<int>(), gh = g["h"].get<int>(), x0 = g["x0"].get<int>(), z0 = g["z0"].get<int>();
    auto clear = [&](double x, double z) {
        int i = (int)py_floordiv(x - x0, G), k = (int)py_floordiv(z - z0, G);
        return 0 <= i && i < gw && 0 <= k && k < gh && !g["cells"][k][i].is_null();
    };
    bool have = false; int bprop = 0; double bmx = 0; std::array<int, 3> best{};
    for (int prop : { 1, 0 }) {
        std::vector<const ojson*> ws;
        if (prop) { for (auto& p : res["props"]) for (auto& w : p) ws.push_back(&w); }
        else for (auto& w : res["path"]) ws.push_back(&w);
        for (auto* wp : ws) {
            const ojson& w = *wp;
            if (!w["crash"].get<int>()) continue;
            double ax = w["a"][0].get<double>(), az = w["a"][1].get<double>(), bx = w["b"][0].get<double>(), bz = w["b"][1].get<double>();
            double dx = bx - ax, dz = bz - az, L = std::pow(dx * dx + dz * dz, .5);
            if (L < 40 || dz / L * dz / L > 0.25 || dx <= 0) continue;
            double mx = (ax + bx) / 2.0, mz = (az + bz) / 2.0;
            if (door_at && std::fabs(mz - (*door_at)[1]) < DOOR_NEAR_Z && std::fabs(mx - (*door_at)[0]) < DOOR_HALF + 50) {
                mx = (*door_at)[0] - (DOOR_HALF + 60);
                if (mx < std::min(ax, bx) + 20) mx = (*door_at)[0] + DOOR_HALF + 60;
                if (mx > std::max(ax, bx) - 20) continue;
            }
            bool ok = true;
            for (int d = 40; d < 340 && ok; d += 40) for (int o : { -40, 0, 40 }) if (!clear(mx + o, mz - d)) { ok = false; break; }
            if (!ok) continue;
            double s1 = -std::fabs(mx);
            if (!have || prop > bprop || (prop == bprop && s1 > bmx)) { have = true; bprop = prop; bmx = s1; best = { (int)mx, (int)mz, prop }; }
        }
    }
    if (have) return best;
    return { 0, res["bbox"][3].get<int>(), 0 };
}
struct ASet { std::vector<Rec> recs; std::map<int, int> nxt; std::vector<std::pair<std::string, std::pair<int, int>>> spans;
              std::vector<std::pair<std::string, std::vector<std::string>>> lists; std::vector<std::pair<std::string, std::vector<std::string>>> fz; };
// a list item: a span name, or a game address ("#hex")
const uint32_t G_APRON_Q[4] = { 0x80147AB8, 0x80147AC0, 0x80147AC8, 0x80147AD0 };
const uint32_t G_SKIRT = 0x80147B30, G_RING_SPAN = 0x80146C44, G_RING_LIST = 0x80146C4C;
std::string addr(uint32_t v) { return "#" + std::to_string(v); }
ASet arena_set(A& a, bool table, ojson* rs, int n, std::optional<std::array<int, 2>>& door_at, std::array<int, 2>& arrive) {
    std::vector<int> ids = { 10, 11, 12, 13, 14, 15, 16, 24, 25, 26, 27, 28, 17, 18, 19, 20, 21, 22, 23, 55, 56, 0, 78, 79, 80, 81, 82, 83, 84, 85, 86 };
    if (!table) for (int x : { 31, 29, 30, 34, 32, 33, 37, 35, 36, 40, 38, 39 }) ids.push_back(x);
    ASet S;
    for (int i : ids) S.recs.push_back(table ? table_moved(game_rec(a, i)) : square(game_rec(a, i)));
    std::vector<int> loop = { 10, 11, 12, 13, 14, 15 };
    if (table) for (int x : { 24, 25, 26, 27, 28 }) loop.push_back(x); else loop.push_back(16);
    for (int x : { 17, 18, 19, 20, 21 }) loop.push_back(x);
    std::vector<std::vector<int>> props; std::vector<int> floors_rs;
    if (rs) {
        auto ws = rs_path_door(*rs, n, door_at);
        std::vector<Rec> path_recs; int i_ = 600;
        for (size_t j = 0; j < ws.size(); j++) {
            Rec r = ws[j].door ? rs_wall(ws[j].door, ws[j].a, ws[j].b, 0x2000, 0x0200)
                  : ws[j].crash ? rs_wall(i_, ws[j].a, ws[j].b, 0x0008, 0x0001) : rs_wall(i_, ws[j].a, ws[j].b, 0x2000, 0x0400);
            if (j == 0) r.id = 21;
            if (j == ws.size() - 1) r.id = 11;
            if (!ws[j].door) i_++;
            path_recs.push_back(r);
        }
        std::vector<Rec> keep;
        for (auto& r : S.recs) if (r.id != 10 && r.id != 21 && r.id != 11) keep.push_back(r);
        keep.insert(keep.end(), path_recs.begin(), path_recs.end());
        S.recs = keep;
