            std::vector<int> pid;
            for (auto& w : p) {
                S.recs.push_back(rs_wall(i_, { w["a"][0].get<int>(), w["a"][1].get<int>() }, { w["b"][0].get<int>(), w["b"][1].get<int>() }, 0x0008, 0x0001));
                pid.push_back(i_); i_++;
