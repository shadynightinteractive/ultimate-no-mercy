// ri_ports_movelib.inc (phase3 p3ports, 2026-11-19): inside Ports::Impl (ri_ports.cpp) -- the mod's move_lib.h, a "lost producer":
// no chain step makes it. Its two parts are made by two Python tools of the Revenge handler (tools\handlers):
//   revlib.py   the head: the library's count and stamp (MOVELIB_N, MOVELIB_STAMP: movelib_revenge.bin's own -- ri_movelib makes
//               that file natively from our frozen library_index.json), MOVELIB_NASH_JK (the number of revenge:1544_1545), the
//               moves made by hand (move_hand);
//   movelib.py  the built-in ports' lists (port_moves, port_moves_at), which revlib.py copies from the move_lib.h before it:
//               each port row of rev_anims.json (gen/revanims.py) as { entry, library move number, the move in its place },
//               the numbers movelib.py's library gave (the hand-made move first, then each different animation pair / hold in
//               the pack's order) -- revlib.py keeps those numbers for the first 78.
// Both from the player's ROMs: the library file (ri_movelib) and the revanims step's rows and files (the pack's animations are
// Revenge's files with No Mercy's first byte, gen/wmport.py: compared here as those bytes, their header and record).

    // movelib.py HAND: the library moves made by hand (ours)
    struct HandMove { const char* id; int ground, base; const char* about; std::vector<std::pair<int, int>> ports; };   // ports: (late, entry)
    static const std::vector<HandMove>& HAND() {
        static const std::vector<HandMove> h = { { "revenge:slam_sharpshooter", 157, 1880,
            "Revenge's code 58 -> 200: the slam (No Mercy's 1880 byte for byte), then the ground grapple at his legs picks 157",
            { { 11, 70 }, { 19, 70 } } } };           // (brethart: ext_late 11, sting: 19 -- movex.c LATE_BRET, LATE_STING)
        return h;
    }

    std::string move_lib_h(const Bytes& lib_bin, const std::string& rev_anims_json) {
        // ---- revlib.py's head, from movelib_revenge.bin ----
        auto u32le = [&](size_t a) { return (uint32_t)lib_bin[a] | (uint32_t)lib_bin[a + 1] << 8 | (uint32_t)lib_bin[a + 2] << 16 | (uint32_t)lib_bin[a + 3] << 24; };
        if (lib_bin.size() < 32 || std::string(lib_bin.begin(), lib_bin.begin() + 8) != "NMMOVLIB" || u32le(8) != 1) fail("ports: movelib_revenge.bin isn't one");
        uint32_t n = u32le(12), stamp = u32le(20);
        size_t mv = 32, st = mv + 16 * (size_t)n + 44 * (size_t)u32le(16);
        auto id_of = [&](uint32_t i) { size_t s = st + u32le(mv + 16 * i), e = s; while (lib_bin[e]) e++; return std::string(lib_bin.begin() + s, lib_bin.begin() + e); };
        uint32_t jk = 0;
        for (uint32_t i = 0; i < n && !jk; i++) if (id_of(i) == "revenge:1544_1545") jk = i + 1;
        if (!jk) fail("ports: movelib_revenge.bin has no revenge:1544_1545");
        std::vector<std::string> L = {
            "// generated by revlib.py (2026-11-13, movelib2: tools\\handlers -- the Revenge handler's library, the",
            "// whole of Revenge's move list from the user's ROM): the built-in move libraries' count and stamp, and the built-in",
            "// ports' lists. The library's moves themselves -- their animations, records and holds -- are the content file",
            "// movelib_revenge.bin, which the exe reads and serves (game file numbers given while a match plays them): movex.c asks",
            "// the exe for a library move by its number (1 = the first).",
            strf("#define MOVELIB_N %u", n),
            strf("#define MOVELIB_STAMP 0x%08Xu   // (the library's moves and IDs: the exe's must be the same, else no library moves)", stamp),
            strf("#define MOVELIB_NASH_JK %u   // (revenge:1544_1545, Kevin Nash's jackknife: QA counts its man's thud, movex.c anim_recpart)", jk),
            "// The library's moves made by hand (numbers 1 .. MOVELIB_HAND_N): no animation of their own -- the No Mercy move's --",
            "// and the ground grapple's pick after it (movex.c LibMove { file, then_file, ground }). Played without the exe.",
            strf("#define MOVELIB_HAND_N %zu", HAND().size()),
            "static const LibMove move_hand[MOVELIB_HAND_N] = {" };
        for (size_t k = 0; k < HAND().size(); k++)
            L.push_back(strf("    { 0, 0, %d },   // %zu %s (on %d): %s", HAND()[k].ground, k + 1, HAND()[k].id, HAND()[k].base, HAND()[k].about));
        L.push_back("};");    // (revlib.py joins the head with a new line after it, then the lists follow)

        // ---- movelib.py's port lists ----
        ojson j = ojson::parse(rev_anims_json);
        struct FileE { std::string name; uint32_t fa, fd; int b0a, b0d; std::string hdr[2], rec[2]; };
        std::vector<FileE> files; std::map<std::string, size_t> fix;          // (fix: the pack's order -- rma numbers rise with it)
        for (auto& f : j["files"]) {
            files.push_back({ f["name"].get<std::string>(), f["fa"].get<uint32_t>(), f["fd"].get<uint32_t>(), f["b0a"].get<int>(), f["b0d"].get<int>(),
                              { f["hdr"][0].get<std::string>(), f["hdr"][1].get<std::string>() }, { f["rec"][0].get<std::string>(), f["rec"][1].get<std::string>() } });
            fix[files.back().name] = files.size() - 1;
        }
        // a pair's content as the game gets it: each file's bytes (Revenge's, No Mercy's first byte), header and record
        typedef std::array<std::string, 6> Content;
        auto content = [&](const std::string& name) {
            const FileE& f = files.at(fix.at(name));
            Bytes a = (*RV)(f.fa), d = (*RV)(f.fd);
            a[0] = (uint8_t)f.b0a; d[0] = (uint8_t)f.b0d;
            return Content{ std::string(a.begin(), a.end()), f.hdr[0], f.rec[0], std::string(d.begin(), d.end()), f.hdr[1], f.rec[1] };
        };
        std::map<Content, std::string> canon;
        for (auto& f : files) canon.emplace(content(f.name), f.name);
        auto first = [&](const std::string& name) { return canon.at(content(name)); };
        struct Row { std::string key; int late, slot, code, move, carrier; std::string name, cont; };
        std::vector<Row> rows;
        for (auto& r : j["rows"])
            rows.push_back({ r["key"].get<std::string>(), r["late"].get<int>(), r["slot"].get<int>(), r["code"].get<int>(), r["move"].get<int>(),
                             r.contains("carrier") ? r["carrier"].get<int>() : 0, r["name"].get<std::string>(),
                             r.contains("cont") ? r["cont"].get<std::string>() : std::string() });
        std::map<std::string, std::string> block_of;
        for (auto& r : rows) if (!r.cont.empty()) block_of.emplace(first(r.name), first(r.cont));
        auto key_of = [&](const Row& r) -> std::pair<std::string, std::string> {
            if (!r.cont.empty()) return { first(r.name), first(r.cont) };
            int played = r.carrier ? r.carrier : r.move;
            auto b = block_of.find(first(r.name));
            if (b != block_of.end() && !(nm_flags(played) & GOES_ON)) return { first(r.name), b->second };
            return { first(r.name), "" };
        };
        std::vector<std::pair<std::string, std::string>> lib;               // (pair, block or "")
        for (auto& r : rows) { auto k = key_of(r); if (std::find(lib.begin(), lib.end(), k) == lib.end()) lib.push_back(k); }
        std::stable_sort(lib.begin(), lib.end(), [&](const auto& x, const auto& y) {
            auto kx = std::make_tuple(fix.at(x.first), !x.second.empty(), x.second.empty() ? (size_t)0 : fix.at(x.second));
            auto ky = std::make_tuple(fix.at(y.first), !y.second.empty(), y.second.empty() ? (size_t)0 : fix.at(y.second));
            return kx < ky; });
        auto num_of = [&](const std::pair<std::string, std::string>& k) { return (int)(std::find(lib.begin(), lib.end(), k) - lib.begin()) + 1 + (int)HAND().size(); };
        std::map<int, std::vector<std::string>> port;                         // late -> its lines
        for (size_t h = 0; h < HAND().size(); h++)
            for (auto& [late, e] : HAND()[h].ports)
                port[late].push_back(strf("    { %d, %zu, 0 },   // %s %s", e, h + 1, late == 11 ? "brethart" : "sting", HAND()[h].id));
        for (auto& r : rows)
            port[r.late].push_back(strf("    { %d, %d, %d },   // %s slot %d: Revenge code %d, on %d%s", r.slot, num_of(key_of(r)), r.carrier,
                                        r.key.c_str(), r.slot, r.code, r.move, r.carrier ? strf(" (in its place %d)", r.carrier).c_str() : ""));
        int n_late = port.rbegin()->first + 1;
        size_t total = 0; for (auto& [l, v] : port) total += v.size();
        L.push_back("// The built-in ports' lists (2026-11-13: what were movex_data.h's rows): a port's moveset entries that play a library");
        L.push_back("// move, { entry, library move number, the move in the entry's place (0: his moveset's) }, in gen/revanims.py's order.");
        L.push_back("// port_moves_at[late] .. port_moves_at[late + 1]: the port at ext_late[late] (roster_ext.h).");
        L.push_back(strf("#define PORT_LATE_N %d", n_late));
        L.push_back(strf("#define PORT_MOVES_N %zu", total));
        L.push_back("static const PortMove port_moves[PORT_MOVES_N] = {");
        std::string starts; size_t at = 0;
        for (int late = 0; late < n_late; late++) {
            starts += (late ? ", " : "") + std::to_string(at);
            auto it = port.find(late);
            if (it != port.end()) for (auto& l : it->second) { L.push_back(l); at++; }
        }
        starts += ", " + std::to_string(at);
        L.push_back("};");
        L.push_back("static const u16 port_moves_at[PORT_LATE_N + 1] = { " + starts + " };");
        std::string txt;                                                       // (LF: written with newline="\n")
        for (auto& l : L) txt += l + "\n";
        return txt;
    }
