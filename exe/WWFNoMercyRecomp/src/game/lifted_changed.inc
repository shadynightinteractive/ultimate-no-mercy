// Changed for new features (Ultimate No Mercy)
// Asks for text `text` at (`x`, `y`) this frame: marks a text with no flag in its top four bits 0x10000000, finds or takes its text item (text_item_for_text when `flags` has 0x8000, else text_item_for_key by `key`), and puts it in the frame's draw requests with `flags` (add_text_draw_request); returns that's result, or 0 with no item free. request_text / request_string and the save, league, credits, entrance and winner screens call it.
// From the N64 function at 0x800DD5A4 (28 instructions).
// Called by: request_text, request_string, show_message_page, run_yes_no_choice and 17 more.
// Random-tested: 200000 plain random inputs, all instructions reached, no difference.
s32 request_text_item(recomp_context* ctx, s32 text, s32 x, s32 y, s32 key, s32 flags) {
    LiftFrame frame(ctx, 0x18);
    frame.keep(0x10, ctx->r16);
    frame.keep(0x14, ctx->r31);
    s32 result;
    s32 marked;
    s32 item;

    marked = text;
    if (!(marked & 0xF0000000)) {
        marked |= 0x10000000;
    }
    if (flags & 0x8000) {
        item = lift_call<s32>(ctx, n64::text_item_for_text)(marked, x, y, key);
    } else {
        item = lift_call<s32>(ctx, n64::text_item_for_key)(marked, x, y, key);
    }
    if (item == 0) {
        return 0;
    }
    result = lift_call<s32>(ctx, n64::add_text_draw_request)(item, flags);
    return result;
}

