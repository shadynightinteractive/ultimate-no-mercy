// Changed for new features (Ultimate No Mercy)
// Loads an overlay: from ROM `rom_start` .. `rom_end` to RAM `ram_start` (read_from_rom of the length) after func_800343C0 and func_80034310 (the caches, by their place), then clears its bss `bss_start` .. `bss_end` (zero_bytes). Caller run_game_loop, with the overlay descriptors' nine words; the mod hooks its return (arcade_overlay_loaded).
// From the N64 function at 0x8000073C (28 instructions).
// Called by: run_game_loop.
// Random-tested: 200000 plain random inputs, all instructions reached, no difference.
void load_overlay(recomp_context* ctx, s32 rom_start, s32 rom_end, s32 ram_start, s32 arg3, s32 arg4, s32 arg5, s32 arg6, s32 bss_start, s32 bss_end) {
    LiftFrame frame(ctx, 0x18);
    frame.keep(0x10, ctx->r16);
    frame.keep(0x14, ctx->r31);
    s32 unused;

    lift_call<s32>(ctx, n64::os_inval_icache)();
    lift_call<f32>(ctx, n64::os_inval_dcache)();
    lift_call<f32>(ctx, n64::read_from_rom)(rom_start, ram_start, rom_end - rom_start);
    unused = lift_call<s32>(ctx, n64::zero_bytes)(bss_start, bss_end - bss_start);
}

// Changed for new features (Ultimate No Mercy)
// Waits until the frame buffer of graphics task `task` (its word +0xC) is neither the one shown now nor the next: first empties the retrace queue 0x8005D528 without blocking (osRecvMesg until it returns -1), then, while osViGetCurrentFramebuffer or osViGetNextFramebuffer gives that buffer, waits for the next retrace message. Caller scheduler_graphics_thread, before it runs each graphics task. A mod hooks its entry. (2026-11-14, rest100: from the lifted C++.)
// From the N64 function at 0x800012B0 (33 instructions).
// Has gotos where m2c couldn't find the loop or the if: its structure is to be tidied by hand.
// Called by: scheduler_graphics_thread.
// Random-tested: 200000 plain random inputs, all instructions reached, no difference.
void wait_framebuffer_free(recomp_context* ctx, P<void> task) {
    LiftFrame frame(ctx, 0x20);
    frame.keep(0x18, ctx->r31);
    frame.keep(0x14, ctx->r17);
    frame.keep(0x10, ctx->r16);
    s32 next_framebuffer;
    s32 framebuffer;

    framebuffer = M2C_FIELD(task, P<s32> , 0xC);
    do {

    } while (lift_call<s32>(ctx, ::osRecvMesg_recomp)(field::var::graphics_retrace_queue, 0, 0) != -1);
    while (lift_call<s32>(ctx, ::osViGetCurrentFramebuffer_recomp)() == framebuffer) {
block_4:
        lift_call<s32>(ctx, ::osRecvMesg_recomp)(field::var::graphics_retrace_queue, 0, 1);
    }
    next_framebuffer = lift_call<s32>(ctx, ::osViGetNextFramebuffer_recomp)();
    if (next_framebuffer == framebuffer) {
        goto block_4;
    }
}

