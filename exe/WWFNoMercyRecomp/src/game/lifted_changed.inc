// The graphics thread's take of a frame `frame_index` (graphics_thread_main; mod/src/hd.c: 'at func_80002730 (the graphics thread takes the frame ...)'): tags each of the frame's draw objects (0x800619B2 of them, pointers at 0x805EA9A0) by its model's +0x18 byte into 0x800619B8 -- bit 7 set gives 0xFF and its float matrix (model +0x9C) is converted into the object's fixed matrix for this frame (+0x38 + frame_index x 0x40, gu_mtx_float_to_fixed); a kind-1 object's tag goes through 0x80043618 -- then queues the objects in eight passes of (tag, kind): (0,0) (0,1) (6,0) (3,0) (4,1) (4,0) (5,1) (5,0) (queue_draw_objects_by_tag; mod/src/tron.c hc_passes).
// From the N64 function at 0x80002730 (97 instructions).
// Called by: graphics_thread_main, func_80003180.
// Random-tested: 200000 plain random inputs, all instructions reached, no difference.
void queue_frame_draw_passes(recomp_context* ctx, s32 frame_index) {
    LiftFrame frame(ctx, 0x38);
    frame.keep(0x1C, ctx->r17);
    frame.keep(0x28, ctx->r20);
    frame.keep(0x34, ctx->r31);
    frame.keep(0x30, ctx->r22);
    frame.keep(0x2C, ctx->r21);
    frame.keep(0x24, ctx->r19);
    frame.keep(0x20, ctx->r18);
    frame.keep(0x18, ctx->r16);
    s32 draw_list_count;
    s32 unused;
    s32 frame_index_s16;
    u32 i;
    P<u8> tag;
    s32 model_tag;
    P<P<void>> object_pointer;
    P<void> object;

    draw_list_count = GAME_VAR(draw_list_count);
    i = 0;
    GAME_VAR(draw_group_count) = 0;
    if (draw_list_count != 0) {
        tag = (P<u8> )field::var::frame_draw_object_tags;
        object_pointer = (P<P<void>> )field::var::frame_draw_list;
        do {
            object = *object_pointer;
            model_tag = M2C_FIELD(M2C_FIELD(object, P<P<void>> , 4), P<u8> , 0x18);
            *tag = model_tag;
            if (model_tag & 0x80) {
                *tag = 0xFF;
                lift_call<f32>(ctx, n64::gu_mtx_float_to_fixed)((s32) (M2C_FIELD(object, P<P<void>> , 4) + 0x9C), (s32) (object + (((s32) (frame_index << 0x10) >> 0xA) + 0x38)));
            } else if (M2C_FIELD(object, P<s32> , 0) == 1) {
                *tag = GAME_TABLE(draw_kind1_tag_map, (model_tag & 0xFF));
            }
            tag += 1;
            i += 1;
            object_pointer += 4;
        } while (i < (u32) GAME_VAR(draw_list_count));
    }
    frame_index_s16 = (s32) (s16) frame_index;
    lift_call<s32>(ctx, n64::queue_draw_objects_by_tag)(frame_index_s16, 0, 0);
    lift_call<s32>(ctx, n64::queue_draw_objects_by_tag)(frame_index_s16, 0, 1);
    lift_call<s32>(ctx, n64::queue_draw_objects_by_tag)(frame_index_s16, 6, 0);
    lift_call<s32>(ctx, n64::queue_draw_objects_by_tag)(frame_index_s16, 3, 0);
    lift_call<s32>(ctx, n64::queue_draw_objects_by_tag)(frame_index_s16, 4, 1);
    lift_call<s32>(ctx, n64::queue_draw_objects_by_tag)(frame_index_s16, 4, 0);
    lift_call<s32>(ctx, n64::queue_draw_objects_by_tag)(frame_index_s16, 5, 1);
    unused = lift_call<s32>(ctx, n64::queue_draw_objects_by_tag)(frame_index_s16, 5, 0);
}

