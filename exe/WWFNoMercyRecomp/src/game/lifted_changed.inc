// From the N64 function at 0x800037BC (12 instructions).
// Called by: start_music, play_sound_with_bank, start_music_from_bank, play_music_song and 1 more.
// Random-tested: 200000 plain random inputs, all instructions reached, no difference.
void stop_music(recomp_context* ctx, s32 frames) {
