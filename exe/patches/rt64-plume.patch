+// [wcw mingw] D3D12 methods that return a struct: MSVC's ABI returns it from the call; the headers' other
+// Windows compilers (MinGW) declare them with the result as a first out-parameter instead.
+#if defined(_MSC_VER) || !defined(_WIN32)
+#   define D3D12_RETVAL(obj, method, type, ...) ((obj)->method(__VA_ARGS__))
+#else
+#   define D3D12_RETVAL(obj, method, type, ...) ([&]() { type d3d12RetVal_; (obj)->method(&d3d12RetVal_ __VA_OPT__(,) __VA_ARGS__); return d3d12RetVal_; }())
+#endif
