diff --git a/src/tools/file_to_c/CMakeLists.txt b/src/tools/file_to_c/CMakeLists.txt
index 22ee3eb..f7b9ace 100644
--- a/src/tools/file_to_c/CMakeLists.txt
+++ b/src/tools/file_to_c/CMakeLists.txt
@@ -2,7 +2,19 @@ cmake_minimum_required(VERSION 3.20)
 project(file_to_c)
 set(CMAKE_CXX_STANDARD 17)
 
+if (CMAKE_CROSSCOMPILING)
+    # [wcw mingw] Cross-building (e.g. for Windows on Linux): the build runs file_to_c, so it's built for the host.
+    set(FILE_TO_C_HOST "${CMAKE_CURRENT_BINARY_DIR}/host/file_to_c")
+    add_custom_command(OUTPUT ${FILE_TO_C_HOST}
+        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/host"
+        COMMAND c++ -std=c++17 -O2 "${CMAKE_CURRENT_SOURCE_DIR}/file_to_c.cpp" -o ${FILE_TO_C_HOST}
+        DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/file_to_c.cpp")
+    add_custom_target(file_to_c DEPENDS ${FILE_TO_C_HOST})
+    set(FILE_TO_C ${FILE_TO_C_HOST} CACHE INTERNAL "file_to_c as the build runs it")
+    return()
+endif()
 add_executable(file_to_c "file_to_c.cpp")
+set(FILE_TO_C file_to_c CACHE INTERNAL "file_to_c as the build runs it")
 
 if (APPLE)
     set_target_properties(file_to_c PROPERTIES
