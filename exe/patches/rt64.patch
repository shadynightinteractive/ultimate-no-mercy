 endfunction()
 
 if (WIN32)
-    set (DXC "${PROJECT_SOURCE_DIR}/src/contrib/dxc/bin/x64/dxc.exe")
+    if (CMAKE_HOST_WIN32)
+        set (DXC "${PROJECT_SOURCE_DIR}/src/contrib/dxc/bin/x64/dxc.exe")
+    else()
+        # [wcw mingw] Cross-building for Windows on Linux: the shaders are compiled by a Linux dxc. It must be the
+        # dxc.exe's version (1.7): the shader libraries are linked when the game runs, by dxcompiler.dll (1.7), which
+        # can't link libraries a newer dxc (the 1.8 dxc-linux here) made. RT64_HOST_DXC_DIR: a Linux dxc 1.7 release
+        # (bin/dxc, lib/libdxcompiler.so, lib/libdxil.so).
+        set(RT64_HOST_DXC_DIR "" CACHE PATH "Linux dxc (1.7) for cross-building for Windows")
+        if (RT64_HOST_DXC_DIR)
+            set (DXC "LD_LIBRARY_PATH=${RT64_HOST_DXC_DIR}/lib" "${RT64_HOST_DXC_DIR}/bin/dxc")
+        else()
+            message(WARNING "RT64_HOST_DXC_DIR not set: the 1.8 dxc-linux compiles the shaders, and dxcompiler.dll (1.7) won't link its shader libraries")
+            set (DXC "LD_LIBRARY_PATH=${PROJECT_SOURCE_DIR}/src/contrib/dxc/lib/x64" "${PROJECT_SOURCE_DIR}/src/contrib/dxc/bin/x64/dxc-linux")
+        endif()
+    endif()
