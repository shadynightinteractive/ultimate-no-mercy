diff --git a/inc/dxcapi.h b/inc/dxcapi.h
index 752041b..f92b95d 100644
--- a/inc/dxcapi.h
+++ b/inc/dxcapi.h
@@ -26,10 +26,40 @@
 #ifdef _WIN32
 
 #ifndef CROSS_PLATFORM_UUIDOF
+#if defined(__MINGW32__) && defined(__cplusplus)
+// [wcw mingw] MinGW's __uuidof is __mingw_uuidof<T>(): each interface gets its ID from the spec string.
+constexpr unsigned dxc_mingw_hex(char c) {
+  return c <= '9' ? unsigned(c - '0') : (c | 0x20) - 'a' + 10u;
+}
+constexpr unsigned long dxc_mingw_hexn(const char *s, int n) {
+  unsigned long v = 0;
+  for (int i = 0; i < n; i++) v = v * 16 + dxc_mingw_hex(s[i]);
+  return v;
+}
+constexpr GUID dxc_mingw_guid(const char *s) {
+  return { dxc_mingw_hexn(s, 8), (unsigned short)dxc_mingw_hexn(s + 9, 4), (unsigned short)dxc_mingw_hexn(s + 14, 4),
+           { (unsigned char)dxc_mingw_hexn(s + 19, 2), (unsigned char)dxc_mingw_hexn(s + 21, 2),
+             (unsigned char)dxc_mingw_hexn(s + 24, 2), (unsigned char)dxc_mingw_hexn(s + 26, 2),
+             (unsigned char)dxc_mingw_hexn(s + 28, 2), (unsigned char)dxc_mingw_hexn(s + 30, 2),
+             (unsigned char)dxc_mingw_hexn(s + 32, 2), (unsigned char)dxc_mingw_hexn(s + 34, 2) } };
+}
+#define CROSS_PLATFORM_UUIDOF(interface, spec)                                 \
+  struct interface;                                                            \
+  extern "C++" {                                                               \
+  template <> inline const GUID &__mingw_uuidof<interface>() {                 \
+    static const GUID iid = dxc_mingw_guid(spec);                              \
+    return iid;                                                                \
+  }                                                                            \
+  template <> inline const GUID &__mingw_uuidof<interface *>() {               \
+    return __mingw_uuidof<interface>();                                        \
+  }                                                                            \
+  }
+#else
 // Warning: This macro exists in WinAdapter.h as well
 #define CROSS_PLATFORM_UUIDOF(interface, spec)                                 \
   struct __declspec(uuid(spec)) interface;
 #endif
+#endif
 
 #else
 
