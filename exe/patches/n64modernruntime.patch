+// [wcw] A mod sets one of its own options, which is saved like a change made in the Mods menu (the mod's config
+// file): recomp_set_config_u32(option_id, value). The value takes the option's type: a Bool's true / false, a
+// Number's value, an Enum's index. (A program without a Mods menu, standalone, keeps its mods' settings this way.)
+void recomp_set_config_u32(uint8_t* rdram, recomp_context* ctx, size_t mod_index) {
+    const std::string option_id = _arg_string<0>(rdram, ctx);
+    const uint32_t value = _arg<1, uint32_t>(rdram, ctx);
+    recomp::config::ConfigValueVariant cur = recomp::mods::get_mod_config_value(mod_index, option_id);
+    if (std::holds_alternative<bool>(cur)) {
+        recomp::mods::set_mod_config_value(mod_index, option_id, recomp::config::ConfigValueVariant{ value != 0 });
+    }
+    else if (std::holds_alternative<double>(cur)) {
+        recomp::mods::set_mod_config_value(mod_index, option_id, recomp::config::ConfigValueVariant{ double(int32_t(value)) });
+    }
+    else if (std::holds_alternative<uint32_t>(cur)) {
+        recomp::mods::set_mod_config_value(mod_index, option_id, recomp::config::ConfigValueVariant{ value });
+    }
+}
