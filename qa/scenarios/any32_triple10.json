{
  "about": "2026-11-18 any32: a TRIPLE THREAT match with 7 extra wrestlers present (slots 3-9); 6x",
  "match": "triple",
  "wrestlers": [
    "STEVE AUSTIN",
    "THE ROCK",
    "TRIPLE H"
  ],
  "costumes": [
    0,
    0,
    0
  ],
  "arena": "RAW IS WAR",
  "control": [
    "cpu",
    "cpu",
    "cpu"
  ],
  "options": {
    "qa_extras": 7,
    "qa_extras_rule": 0,
    "qa_extras_wait": 10
  },
  "matches": 1,
  "seconds": 600,
  "speed": 6,
  "shots": 4,
  "expect": [
    {
      "name": "the match started",
      "when": "any",
      "check": "stage == 2 and match_frames != 0xFFFF and match_frames > 30"
    },
    {
      "name": "the extras were set up: 7 present, 3 competitors, the engine counts 10",
      "when": "match",
      "check": "(bs_tries & 0xFF) == 7 and ((bs_step >> 8) & 0xFF) == 3 and (bs_step & 0xFF) == 10"
    },
    {
      "name": "the extras stood first, then joined in",
      "when": "match",
      "check": "(bs_step >> 24) & 1 == 1"
    },
    {
      "name": "every extra acted (the computer pressed his buttons)",
      "when": "match",
      "check": "((bs_tries >> 8) & 0xFF) == 7"
    },
    {
      "name": "extras took hits (stamina down): at least half",
      "when": "match",
      "check": "((bs_tries >> 16) & 0xFF) * 2 >= 7"
    },
    {
      "name": "extras grappled (states 80 / 81)",
      "when": "match",
      "check": "((bs_tries >> 24) & 0xFF) >= 1"
    },
    {
      "name": "no position ever went bad",
      "when": "always",
      "check": "finite(s0_x, s0_y, s0_z, s1_x, s1_y, s1_z, s2_x, s2_z, s5_x, s5_z)"
    },
    {
      "name": "the match finished and the game quit by itself",
      "when": "end",
      "check": "matches >= 1 or stage != 2"
    }
  ]
}